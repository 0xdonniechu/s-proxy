{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "s-proxy",
  "version": "1.0.5",
  "identifier": "com.donniechu.sproxy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "s-proxy — Surfshark & GoLogin Proxy Hub",
        "width": 800,
        "height": 600,
        "minWidth": 740,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "publisher": "Donnie Chu",
    "copyright": "Copyright (c) 2026 Donnie Chu. All rights reserved.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local Hybrid VPN Proxy Hub for Surfshark & GoLogin",
    "longDescription": "Turns Surfshark VPN into local SOCKS5/HTTP proxy endpoints and syncs them to GoLogin profiles.",
    "windows": {
      "nsis": {
        "compression": "none",
        "installMode": "currentUser"
      }
    }
  }
}
